# Copy to .env.local and fill in values.

NEXT_PUBLIC_SITE_URL=https://dawgz.hiresignalworks.com
# Alias supported by some docs — prefer NEXT_PUBLIC_SITE_URL
# NEXT_PUBLIC_APP_URL=https://dawgz.hiresignalworks.com

# Supabase (hobby/Dugout on main; Signal Works Pro on feature branch preview)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Training vertical tenant UUID on Signal Works Pro (feature branch / disposable only)
# TRAINING_TENANT_ID=

# Staff password reset emails use NEXT_PUBLIC_SITE_URL + /admin/reset-password
# Add the same URLs under Supabase Auth → URL configuration → Redirect URLs.

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@hiresignalworks.com
STAFF_NOTIFICATION_EMAIL=hello@hiresignalworks.com

# Stripe (DAWG merchant account — test keys locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set to true when Stripe checkout is ready for bookings and packages
# NEXT_PUBLIC_ONLINE_PAYMENT_ENABLED=true

# Cron / cleanup for abandoned Stripe holds
CRON_SECRET=
